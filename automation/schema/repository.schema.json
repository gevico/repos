{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gevico repository request",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "visibility", "access"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 350 },
    "visibility": { "enum": ["public", "private"] },
    "topics": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "maxLength": 50, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["users", "teams"],
      "properties": {
        "users": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-zA-Z0-9]+(?:-[a-zA-Z0-9]+)*$", "maxLength": 39 },
          "additionalProperties": { "$ref": "#/definitions/role" }
        },
        "teams": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$" },
          "additionalProperties": { "$ref": "#/definitions/role" }
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "repository"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 }
      }
    }
  },
  "definitions": { "role": { "enum": ["pull", "triage", "push", "maintain", "admin"] } }
}
