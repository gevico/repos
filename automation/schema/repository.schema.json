{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gevico repository request",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "visibility", "access"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9_.-]+$", "not": { "enum": [".", ".."] } },
    "mode": { "enum": ["create", "existing", "fork", "mirror"] },
    "status": { "enum": ["active", "archived", "deleted"] },
    "repository_id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "description": { "type": "string", "maxLength": 350 },
    "default_branch": { "type": "string", "minLength": 1, "maxLength": 255 },
    "readme_template": { "enum": ["project", "library", "minimal"] },
    "license": { "enum": ["agpl-3.0", "apache-2.0", "bsd-2-clause", "bsd-3-clause", "bsl-1.0", "cc0-1.0", "epl-2.0", "gpl-2.0", "gpl-3.0", "lgpl-2.1", "mit", "mpl-2.0", "unlicense"] },
    "fork": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "repository", "source_repository_id"],
      "properties": {
        "owner": { "type": "string", "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "not": { "enum": [".", ".."] } },
        "source_repository_id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "default_branch_only": { "type": "boolean" }
      }
    },
    "mirror": {
      "type": "object", "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "maxLength": 2048, "pattern": "^https://[a-z0-9.-]+(?:/[A-Za-z0-9_.~-]+)+$" },
        "source_repository_id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "visibility": { "enum": ["public", "private"] },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admin_bypass": { "enum": ["none", "pull_request", "always"] }
      }
    },
    "topics": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "maxLength": 50, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["users", "teams"],
      "properties": {
        "users": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-zA-Z0-9]+(?:-[a-zA-Z0-9]+)*$", "maxLength": 39 },
          "additionalProperties": { "$ref": "#/definitions/role" }
        },
        "teams": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$" },
          "additionalProperties": { "$ref": "#/definitions/role" }
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "repository"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "status": { "enum": ["archived", "deleted"] } }, "required": ["status"] },
    "then": { "properties": { "repository_id": { "$ref": "#/properties/repository_id" } }, "required": ["repository_id"] }
  }],
  "definitions": { "role": { "enum": ["pull", "triage", "push", "maintain", "admin"] } }
}
